<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="16dp" android:background="#0A0A0A" android:layout_width="match_parent" android:layout_height="match_parent">
  <TextView android:text="ابن دليم @ss66s1" android:textColor="#FFD700" android:textSize="22sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <TextView android:id="@+id/quoteText" android:text="القوة الحقيقية في أن تعمل مرة وتستفيد ألف مرة - ابن دليم" android:textColor="#FFD700" android:background="#222222" android:padding="12dp" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <Button android:id="@+id/btnEnableAccess" android:text="فعل صلاحية الوصول" android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <LinearLayout android:orientation="horizontal" android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
    <Button android:id="@+id/btnRecord" android:text="ابدأ التسجيل" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
    <Button android:id="@+id/btnStopRecord" android:text="أوقف التسجيل" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
  </LinearLayout>
  <TextView android:id="@+id/counterText" android:text="0" android:textColor="#00FF94" android:textSize="64sp" android:textStyle="bold" android:gravity="center" android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <TextView android:id="@+id/counterLabel" android:text="مرة دزلك حلو - @ss66s1" android:textColor="#FFFFFF" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <LinearLayout android:orientation="horizontal" android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
    <Button android:id="@+id/btnPlayLoop" android:text="تشغيل ∞" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
    <Button android:id="@+id/btnStopLoop" android:text="إيقاف" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
  </LinearLayout>
</LinearLayout>
